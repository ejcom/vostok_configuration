# Описание платы для установщика VOSTOK (формат: KEY="значение", без кода; читает vostok/boards.py).
# Поля: LABEL ROLE CHIP FAMILY MACH CLOCK APP_OFFSET USB CAN CAN_KIND INITIAL_PINS BRIDGE_INITIAL_PINS
#       KATAPULT_INITIAL_PINS KATAPULT_LED KATAPULT_DOUBLE_RESET CFG ALIASES DFU_HINT DFU_HOW ELEC_PATTERN
#       TEMPLATE HEAD_NAMES VERIFIED DOC PINOUT PINOUT_NOTE NOTE. Конфиги сборки создаёт tools/gen_configs.py.
# PINOUT - необязательное поле: картинки распиновки платы, пути от installer/pinouts/ через пробел (список: pinouts/README.md);
#          пусто - установщик показывает DOC.
# PINOUT_NOTE - необязательное поле: предупреждение, которое печатается рядом с картинкой (например, пины не совпадают с листом).
LABEL="MKS SKIPR"
ROLE="main"
CHIP="stm32f407xx"
FAMILY="f4"
MACH="STM32F407"
CLOCK="8M"
APP_OFFSET="8000"
USB="PA11_PA12"
CAN=""
CAN_KIND=""
INITIAL_PINS=""
BRIDGE_INITIAL_PINS=""
KATAPULT_INITIAL_PINS=""
KATAPULT_LED=""
KATAPULT_DOUBLE_RESET="y"
CFG="mks-skipr"
ALIASES="skipr"
DFU_HINT="MCU стоит на одной плате с RK3328 (Armbian), штатная связь с ним - UART1 PA9/PA10 (/dev/ttyS0), а не USB. По схеме есть кнопки BOOT0 (S2) и RESET (S1): зажмите BOOT0, нажмите RESET, отпустите BOOT0; для DFU соедините разъём Type-C с хостом"
DFU_HOW="button"
ELEC_PATTERN=""
TEMPLATE=""
HEAD_NAMES=""
VERIFIED="no"
DOC="https://github.com/makerbase-mks/MKS-SKIPR (hardware/MKS SKIPR V1.0_002, klipper firmware)"
PINOUT=""
PINOUT_NOTE=""
NOTE="Не проверено на железе. STM32F407VET6, кварц 8 МГц, USB PA11/PA12 только на разъём Type-C (схема MKS SKIPR V1.0_002). Штатный Klipper MKS собран на последовательный порт USART1 PA10/PA9, загрузчик 48KiB, прошивка с SD-карты (mks_skipr.bin); здесь собираются USB-прошивки katapult с загрузчиком 32KiB, это нештатный режим: хост подключится по USB-кабелю, а не по UART. CAN у платы есть (CAN2 на PB12/PB13, трансивер на плате), но моста USB-CAN к встроенному хосту нет (с SoC MCU связан только UART), поэтому CAN пустой. Картинка распиновки не включена: нет явной лицензии на рисунки."
