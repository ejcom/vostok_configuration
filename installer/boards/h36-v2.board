# Описание платы для установщика VOSTOK (формат: KEY="значение", без кода; читает lib/boards.sh).
# Поля: LABEL ROLE CHIP FAMILY MACH CLOCK APP_OFFSET USB CAN CAN_KIND INITIAL_PINS BRIDGE_INITIAL_PINS
#       KATAPULT_INITIAL_PINS KATAPULT_LED KATAPULT_DOUBLE_RESET CFG ALIASES DFU_HINT DFU_HOW ELEC_PATTERN
#       TEMPLATE HEAD_NAMES VERIFIED DOC NOTE. Конфиги сборки создаёт tools/gen_configs.sh.
LABEL="Fysetc H36 v2"
ROLE="head"
CHIP="stm32g431xx"
FAMILY="g"
MACH="STM32G431"
CLOCK="12M"
APP_OFFSET="2000"
USB=""
CAN="PA11_PA12"
CAN_KIND="direct"
INITIAL_PINS="!PA2"
BRIDGE_INITIAL_PINS=""
KATAPULT_INITIAL_PINS="!PA2"
KATAPULT_LED=""
KATAPULT_DOUBLE_RESET="y"
CFG="stm32g431xx"
ALIASES="v2"
DFU_HINT="зажмите BOOT0, нажмите RST, отпустите BOOT0"
DFU_HOW="button"
ELEC_PATTERN="H36v2"
TEMPLATE=""
HEAD_NAMES="T0CB,T1CB"
VERIFIED="no"
DOC="https://k3d.tech/vostok/manual/electronics/firmware/"
NOTE="Пин светодиода katapult гайд не указывает: LED не включаем."
