# Описание платы для установщика VOSTOK (формат: KEY="значение", без кода; читает lib/boards.sh).
# Поля: LABEL ROLE CHIP FAMILY MACH CLOCK APP_OFFSET USB CAN CAN_KIND INITIAL_PINS BRIDGE_INITIAL_PINS
#       KATAPULT_INITIAL_PINS KATAPULT_LED KATAPULT_DOUBLE_RESET CFG ALIASES DFU_HINT DFU_HOW ELEC_PATTERN
#       TEMPLATE HEAD_NAMES VERIFIED DOC NOTE. Конфиги сборки создаёт tools/gen_configs.sh.
LABEL="BTT Manta M8P v2.0"
ROLE="main"
CHIP="stm32h723xx"
FAMILY="h7"
MACH="STM32H723"
CLOCK="25M"
APP_OFFSET="20000"
USB="PA11_PA12"
CAN="PD0_PD1"
CAN_KIND="cmenu"
INITIAL_PINS=""
BRIDGE_INITIAL_PINS=""
KATAPULT_INITIAL_PINS=""
KATAPULT_LED=""
KATAPULT_DOUBLE_RESET="y"
CFG="manta-m8p-v2.0"
ALIASES="m8p-v2.0"
DFU_HINT="MCU стоит на одной плате с CB1/CM4, USB к нему внутренний: зажмите BOOT, нажмите RESET, отпустите BOOT"
DFU_HOW="button"
ELEC_PATTERN=""
TEMPLATE=""
HEAD_NAMES=""
VERIFIED="no"
DOC="Manta-M8P V2.0/Firmware/generic-bigtreetech-manta-m8p-V2_0.cfg"
NOTE="Тот же чип H723, что у Octopus Pro v1.1, но другая плата и другие пины."
