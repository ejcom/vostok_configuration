# Описание платы для установщика VOSTOK (формат: KEY="значение", без кода; читает vostok/boards.py).
# Поля: LABEL ROLE CHIP FAMILY MACH CLOCK APP_OFFSET USB CAN CAN_KIND INITIAL_PINS BRIDGE_INITIAL_PINS
#       KATAPULT_INITIAL_PINS KATAPULT_LED KATAPULT_DOUBLE_RESET CFG ALIASES DFU_HINT DFU_HOW ELEC_PATTERN
#       TEMPLATE HEAD_NAMES VERIFIED DOC PINOUT PINOUT_NOTE NOTE. Конфиги сборки создаёт tools/gen_configs.py.
# PINOUT - необязательное поле: картинки распиновки платы, пути от installer/pinouts/ через пробел (список: pinouts/README.md);
#          пусто - установщик показывает DOC.
# PINOUT_NOTE - необязательное поле: предупреждение, которое печатается рядом с картинкой (например, пины не совпадают с листом).
LABEL="Fysetc Spider v3.0 H723"
ROLE="main"
CHIP="stm32h723xx"
FAMILY="h7"
MACH="STM32H723"
CLOCK="25M"
APP_OFFSET="20000"
USB="PA11_PA12"
CAN="PD0_PD1"
CAN_KIND="cmenu"
INITIAL_PINS=""
BRIDGE_INITIAL_PINS=""
KATAPULT_INITIAL_PINS=""
KATAPULT_LED=""
KATAPULT_DOUBLE_RESET="y"
CFG="spider-v3-h723"
ALIASES="spider-h723"
DFU_HINT="зажмите кнопку BT0, нажмите RST, отпустите BT0"
DFU_HOW="button"
ELEC_PATTERN=""
TEMPLATE=""
HEAD_NAMES=""
VERIFIED="no"
DOC="https://docs.fysetc.com (spider-v30-h7), drklipper"
PINOUT=""
NOTE="Отдельной распиновки H723 у Fysetc нет, совпадение пинов с листом v3.0 F446 не проверено: PINOUT пуст, установщик показывает DOC."
