# Описание платы для установщика VOSTOK (формат: KEY="значение", без кода; читает vostok/boards.py).
# Поля: LABEL ROLE CHIP FAMILY MACH CLOCK APP_OFFSET USB CAN CAN_KIND INITIAL_PINS BRIDGE_INITIAL_PINS
#       KATAPULT_INITIAL_PINS KATAPULT_LED KATAPULT_DOUBLE_RESET CFG ALIASES DFU_HINT DFU_HOW ELEC_PATTERN
#       TEMPLATE HEAD_NAMES VERIFIED DOC PINOUT PINOUT_NOTE NOTE. Конфиги сборки создаёт tools/gen_configs.py.
# PINOUT - необязательное поле: картинки распиновки платы, пути от installer/pinouts/ через пробел (список: pinouts/README.md);
#          пусто - установщик показывает DOC.
# PINOUT_NOTE - необязательное поле: предупреждение, которое печатается рядом с картинкой (например, пины не совпадают с листом).
LABEL="Mellow FLY Super8 Pro H723"
ROLE="main"
CHIP="stm32h723xx"
FAMILY="h7"
MACH="STM32H723"
CLOCK="25M"
APP_OFFSET="20000"
USB="PA11_PA12"
CAN="PB8_PB9"
CAN_KIND="cmenu"
INITIAL_PINS=""
BRIDGE_INITIAL_PINS=""
KATAPULT_INITIAL_PINS=""
KATAPULT_LED=""
KATAPULT_DOUBLE_RESET="y"
CFG="fly-super8-pro-h723"
ALIASES="super8pro super8-pro flysuper8pro"
DFU_HINT="поставьте джампер BOOT0 до подключения USB, затем подключите кабель (место джампера - на рисунке в документации Mellow); после прошивки джампер снять"
DFU_HOW="jumper"
ELEC_PATTERN=""
TEMPLATE=""
HEAD_NAMES=""
VERIFIED="no"
DOC="https://mellow-3d.github.io/fly_super8_pro_h723_klipper_usbtocan.html"
PINOUT=""
PINOUT_NOTE=""
NOTE="Не проверено на железе. Кварц 25 МГц и загрузчик 128KiB взяты из документации Mellow (страницы Klipper/Katapult), но схема в репозитории Mellow-3D/Fly-Super8Pro (Super8Pro_Schematic.pdf, 2022-09) показывает STM32H743ZIT6 и кварц 8MHZ, а в документации сказано, что есть версия на H743: сверьте маркировку чипа и кварца на своей плате до прошивки. Если на плате H743 или кварц 8 МГц, эта сборка не запустится (нужны MACH_STM32H743 и 8M, их в реестре для платы нет): не прошивайте, пока не проверили маркировку чипа. CAN PB8/PB9 (MCP2542) подтверждён и документацией, и схемой. Картинка распиновки не включена: у репозиториев Mellow-3D нет лицензии."
