# Описание платы для установщика VOSTOK (формат: KEY="значение", без кода; читает vostok/boards.py).
# Поля: LABEL ROLE CHIP FAMILY MACH CLOCK APP_OFFSET USB CAN CAN_KIND INITIAL_PINS BRIDGE_INITIAL_PINS
#       KATAPULT_INITIAL_PINS KATAPULT_LED KATAPULT_DOUBLE_RESET CFG ALIASES DFU_HINT DFU_HOW ELEC_PATTERN
#       TEMPLATE HEAD_NAMES VERIFIED DOC NOTE. Конфиги сборки создаёт tools/gen_configs.py.
LABEL="Fysetc H36 v1.3"
ROLE="head"
CHIP="stm32g0b1xx"
FAMILY="g"
MACH="STM32G0B1"
CLOCK="12M"
APP_OFFSET="2000"
USB=""
CAN="PD0_PD1"
CAN_KIND="mmenu"
INITIAL_PINS="!PA2"
BRIDGE_INITIAL_PINS=""
KATAPULT_INITIAL_PINS="!PA2"
KATAPULT_LED=""
KATAPULT_DOUBLE_RESET="y"
CFG="stm32g0b1xx"
ALIASES="v1.3"
DFU_HINT="зажмите BOOT0, нажмите RST, отпустите BOOT0"
DFU_HOW="button"
ELEC_PATTERN="H36v1.3"
TEMPLATE=""
HEAD_NAMES="T0CB,T1CB"
VERIFIED="no"
DOC="https://k3d.tech/vostok/manual/electronics/firmware/"
NOTE=""
