# Описание платы для установщика VOSTOK (формат: KEY="значение", без кода; читает vostok/boards.py).
# Поля: LABEL ROLE CHIP FAMILY MACH CLOCK APP_OFFSET USB CAN CAN_KIND INITIAL_PINS BRIDGE_INITIAL_PINS
#       KATAPULT_INITIAL_PINS KATAPULT_LED KATAPULT_DOUBLE_RESET CFG ALIASES DFU_HINT DFU_HOW ELEC_PATTERN
#       TEMPLATE HEAD_NAMES VERIFIED DOC PINOUT PINOUT_NOTE NOTE. Конфиги сборки создаёт tools/gen_configs.py.
# PINOUT - необязательное поле: картинки распиновки платы, пути от installer/pinouts/ через пробел (список: pinouts/README.md);
#          пусто - установщик показывает DOC.
# PINOUT_NOTE - необязательное поле: предупреждение, которое печатается рядом с картинкой (например, пины не совпадают с листом).
LABEL="MKS Monster8 V2"
ROLE="main"
CHIP="stm32f407xx"
FAMILY="f4"
MACH="STM32F407"
CLOCK="8M"
APP_OFFSET="8000"
USB="PA11_PA12"
CAN="PB8_PB9"
CAN_KIND="cmenu"
INITIAL_PINS=""
BRIDGE_INITIAL_PINS=""
KATAPULT_INITIAL_PINS=""
KATAPULT_LED=""
KATAPULT_DOUBLE_RESET="y"
CFG="mks-monster8-v2"
ALIASES="monster8 monster8-v2"
DFU_HINT="зажмите BOOT0 (кнопка S2), нажмите RESET (S1), отпустите BOOT0; после прошивки katapult стоковый загрузчик MKS (SD-карта, 48KiB) заменяется"
DFU_HOW="button"
ELEC_PATTERN=""
TEMPLATE="mks_monster8_v2"
HEAD_NAMES=""
VERIFIED="no"
DOC="https://github.com/makerbase-mks/MKS-Monster8 (hardware/MKS Monster8 V2.0_003, klipper firmware)"
PINOUT="MKS/Monster8/v2_0/pinout.pdf"
PINOUT_NOTE=""
NOTE="Не проверено на железе. Стоковая сборка MKS: 8 МГц, USB PA11/PA12, загрузчик 48KiB (скриншот menuconfig в репозитории MKS); здесь katapult с загрузчиком 32KiB: по отчёту сообщества мост USB-CAN работал с 32KiB и не поднимал can0 с 48KiB, документации MKS на это нет. CAN1 на PB8/PB9 по схеме V2.0_003, но на плате перемычка J2 выбирает I2C или CAN: поставьте её на CAN. Схема допускает F446VET6 или F407VET6 (резисторы R42/C9/C14): проверьте маркировку чипа. Кварц 8 МГц - по скриншоту MKS, на схеме номинал Y1 не указан. Картинка распиновки не включена: лист PIN - растровый PDF, явной лицензии на рисунки нет. Риск: при несовпадении смещения загрузчика can0 не поднимется; стоковый загрузчик MKS (48KiB) заменяется Katapult, откат - прошивкой стока с SD-карты. Пресет пинов (с 1.8) по generic-mks-monster8.cfg (Klipper) и printer_v2.cfg MKS: слоты, CS/UART, нагреватели, вентиляторы, концевики; у X и Y общий enable PC15, пины SPI4 (PE12/PE14/PE13) выведены из spi_bus: spi4, питания зонда нет (ЗАПОЛНИТЕ): сверьте со своей платой."
